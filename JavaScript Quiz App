<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JavaScript Quiz</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f4f4;
            text-align: center;
            padding: 50px 15px;
        }

        .container {
            background: white;
            max-width: 450px;
            margin: auto;
            padding: 25px;
            border-radius: 10px;
        }

        button {
            display: block;
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            cursor: pointer;
            border: 1px solid #ccc;
            border-radius: 5px;
            background: #eee;
        }

        button:hover {
            background: #dce8ff;
        }

        #nextButton {
            background: #2563eb;
            color: white;
            border: none;
        }

        #result {
            font-weight: bold;
            margin-top: 20px;
        }
    </style>
</head>

<body>

    <div class="container">
        <h2>JavaScript Quiz</h2>

        <h3 id="question"></h3>

        <div id="options"></div>

        <p id="result"></p>

        <button id="nextButton">Next Question</button>
    </div>

    <script>
        const questions = [
            {
                question: "Which keyword declares a variable in JavaScript?",
                options: ["var", "int", "string", "float"],
                answer: "var"
            },
            {
                question: "Which method displays a message in the console?",
                options: ["alert()", "console.log()", "print()", "display()"],
                answer: "console.log()"
            },
            {
                question: "Which symbol is used for strict equality?",
                options: ["=", "==", "===", "!="],
                answer: "==="
            },
            {
                question: "Which method adds an element to the end of an array?",
                options: ["pop()", "push()", "shift()", "remove()"],
                answer: "push()"
            },
            {
                question: "Which keyword is used to define a function?",
                options: ["function", "method", "define", "func"],
                answer: "function"
            }
        ];

        let currentQuestion = 0;
        let score = 0;
        let answered = false;

        const questionElement = document.getElementById("question");
        const optionsElement = document.getElementById("options");
        const resultElement = document.getElementById("result");
        const nextButton = document.getElementById("nextButton");

        function loadQuestion() {
            answered = false;
            resultElement.textContent = "";

            const current = questions[currentQuestion];

            questionElement.textContent =
                `Question ${currentQuestion + 1}: ${current.question}`;

            optionsElement.innerHTML = "";

            current.options.forEach(function(option) {
                const button = document.createElement("button");

                button.textContent = option;

                button.addEventListener("click", function() {
                    checkAnswer(option, button);
                });

                optionsElement.appendChild(button);
            });
        }

        function checkAnswer(selected, button) {
            if (answered) return;

            answered = true;

            if (selected === questions[currentQuestion].answer) {
                score++;
                resultElement.textContent = "Correct Answer!";
                resultElement.style.color = "green";
            } else {
                resultElement.textContent =
                    "Wrong Answer! Correct answer: " +
                    questions[currentQuestion].answer;
                resultElement.style.color = "red";
            }
        }

        function nextQuestion() {
            if (!answered) {
                resultElement.textContent = "Please select an answer first!";
                resultElement.style.color = "red";
                return;
            }

            currentQuestion++;

            if (currentQuestion < questions.length) {
                loadQuestion();
            } else {
                showResult();
            }
        }

        function showResult() {
            questionElement.textContent = "Quiz Completed!";
            optionsElement.innerHTML = "";
            resultElement.textContent =
                `Your Score: ${score} / ${questions.length}`;
            resultElement.style.color = "green";
            nextButton.style.display = "none";
        }

        nextButton.addEventListener("click", nextQuestion);

        loadQuestion();
    </script>

</body>
</html>
